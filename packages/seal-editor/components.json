{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/tailwind.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "#components",
    "utils": "#lib/utils",
    "ui": "#components/ui",
    "lib": "#lib",
    "hooks": "#hooks"
  },
  "iconLibrary": "lucide",
  "registries": {
    "@reui": {
      "headers": {
        "Authorization": "Bearer ${REUI_LICENSE_KEY}"
      },
      "url": "https://reui.io/r/base/{name}.json"
    }
  }
}
