{
  "name": "@republicroad/seal-appshell",
  "version": "1.4.1",
  "description": "Application shell for @republicroad/seal-editor — custom node hosting, UI slot overrides and skinning",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:npm-smoke": "node scripts/npm-smoke.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@republicroad/seal-editor": "^1.1.0",
    "monaco-editor": "^0.52.2",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": false
    }
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@republicroad/seal-editor": "workspace:^1.4.1",
    "@tanstack/react-virtual": "catalog:",
    "axios": "^1.13.5",
    "better-auth": "^1.6.25",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "ts-pattern": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@lezer/common": "catalog:",
    "@lezer/lr": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.0.1",
    "monaco-editor": "^0.52.2",
    "typescript": "^5.9.3",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
