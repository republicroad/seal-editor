-// 评估目的见 docs/design/reui-flow-pilot.md（可搬部件 / 源码直通配合 / trace 监控可行性）。
-import { Page } from '../components/blocks/flow-1/page';
+// ReUI flow 块对照页：flow-1/2/3 上游原版（2026-09-26 经 base-nova registry 重装，
+// 取代 2026-09-17 的本地手拷试点）。块自带全屏顶栏，故不走 InstanceShell。
+// 用途与评估史见 docs/design/reui-flow-pilot.md 与 dt-datagrid-retrofit-plan.md。
+import { Page as Flow1Page } from '../components/blocks/flow-1/page';
+import { Page as Flow2Page } from '../components/blocks/flow-2/page';
+import { Page as Flow3Page } from '../components/blocks/flow-3/page';
 import '../playground.css';
 import '../theme.css';
 
+const PAGES: Record<string, React.FC> = {
+  'flow-1': Flow1Page,
+  'flow-2': Flow2Page,
+  'flow-3': Flow3Page,
+};
+
+const useHashRoute = (): string => {
+  const [hash, setHash] = React.useState(() => window.location.hash || '#flow-1');
+  React.useEffect(() => {
+    const onHash = () => setHash(window.location.hash || '#flow-1');
+    window.addEventListener('hashchange', onHash);
+    return () => window.removeEventListener('hashchange', onHash);
+  }, []);
+  return hash.replace(/^#/, '');
+};
+
+const RoutedBlock: React.FC = () => {
+  const hash = useHashRoute();
+  const Page = PAGES[hash] ?? Flow1Page;
+  return <Page />;
+};
+
 createRoot(document.getElementById('root')!).render(
   <React.StrictMode>
     <ThemeContextProvider>
-      <Page />
+      <RoutedBlock />
     </ThemeContextProvider>
   </React.StrictMode>,
 );
