+    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=96&h=96&dpr=2&q=80',
+  },
+};
+
+// customize: replace with your own agent steps.
+const SEED: {
+  id: string;
+  parent?: string;
+  branchLabel?: string;
+  data: AgentNodeData;
+}[] = [
+  {
+    id: 'overdue',
+    data: {
+      app: 'stripe',
+      title: 'Stripe',
+      detail: 'Invoice 3 days overdue',
+      facts: ['inv_9412', 'EUR 4,180'],
+      status: 'passed',
