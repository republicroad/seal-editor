+  const apple = useIsApplePlatform();
+  const titleId = useId();
+  const glyph = (key: string) =>
+    key === 'mod' ? (apple ? '⌘' : 'Ctrl') : key === 'shift' ? (apple ? '⇧' : 'Shift') : key;
